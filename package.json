{
  "name": "upi-qr-split-payment-system",
  "version": "1.0.0",
  "description": "Vendor-Based UPI QR Payment Management System with Dynamic SplitPay Engine",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "cd server && node index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && node index.js"
  },
  "keywords": [
    "upi",
    "qr-code",
    "split-payment",
    "vendor-management",
    "npci"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "localtunnel": "^2.0.2"
  }
}
